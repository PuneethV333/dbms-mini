# Local SQLite database (no Docker/Postgres/Redis required)
DATABASE_URL="file:./dev.db"

# Signing secret for the HttpOnly session cookie.
# Generate a strong value for any shared environment.
JWT_SECRET="bsafe-dev-only-secret-change-me-32chars"

# Comma-separated emails promoted to admin on signup/sign-in.
ADMIN_EMAILS="admin@bsafe.test"

# Used to build the tokenized tracking link included in notification emails.
WEB_BASE_URL="http://localhost:3000"

# Email notifications (SMS is intentionally not part of this build).
# true = log the email to the server console and mark it sent.
EMAIL_DRY_RUN="true"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="bSafe"
SMTP_SECURE="false"
